# Tendril-Graph — credential template
# Copy to .env and fill in your values. Never commit .env.
#
# For M0–M4 development (fixture-based tests): NONE of these are required.
# For M5+ (live CLI / tendril serve): fill in the providers you want active.
# All credentials must be READ-ONLY. See README.md security posture section.

# ── GitHub (VCS) ──────────────────────────────────────────────────────────────
# Preferred: GitHub App (spans multiple orgs cleanly; fine-grained PATs are single-org only)
#
# Steps to create a GitHub App:
#   1. github.com → Settings → Developer settings → GitHub Apps → "New GitHub App"
#      (or for an org: github.com/organizations/<org>/settings/apps)
#   2. Set a name and homepage URL (any URL works for private use)
#   3. Permissions → Repository permissions:
#        Contents: Read-only
#        Metadata: Read-only
#      If you plan to use GitHub Actions connector (M7):
#        Actions: Read-only
#        Variables: Read-only
#        Environments: Read-only
#   4. Uncheck "Active" under Webhook (not needed)
#   5. Click "Create GitHub App" — note the App ID on the app settings page
#   6. Scroll to "Private keys" → "Generate a private key" → save the .pem file
#   7. Install the app: app settings → "Install App" → select the target org(s)
#   8. After install, the URL contains the Installation ID:
#      github.com/settings/installations/<INSTALLATION_ID>
#
GH_APP_ID=
GH_INSTALL_ID=
GH_PRIVATE_KEY_PATH=       # absolute path to the downloaded .pem file

# Alternative: fine-grained PAT (single org only)
#   github.com → Settings → Developer settings → Personal access tokens → Fine-grained tokens
#   → "Generate new token" → Resource owner: <your-org>
#   → Repository access: All repositories (or select specific ones)
#   → Permissions: Contents: Read-only, Metadata: Read-only
GH_TOKEN=

# ── Bitbucket Data Center (VCS) ───────────────────────────────────────────────
# Steps:
#   1. Log in to your Bitbucket DC instance
#   2. Profile icon (top right) → Manage account → Personal access tokens
#   3. "Create token" → name it, set Expiry if desired
#   4. Permissions: Projects: Read, Repositories: Read
#   5. Copy the token — it is only shown once
#
BB_BASE_URL=https://bitbucket.example.com   # your self-hosted instance URL (no trailing slash)
BB_TOKEN=

# ── Bitbucket Cloud (VCS) ─────────────────────────────────────────────────────
# Steps:
#   1. bitbucket.org → Personal settings (avatar, bottom left) → App passwords
#   2. "Create app password" → name it
#   3. Permissions: Repositories: Read
#   4. Copy the password — shown once
#   Note: Bitbucket Cloud API tokens expire — the connector handles refresh automatically.
#
BB_CLOUD_USERNAME=         # your Bitbucket Cloud username (not email)
BB_CLOUD_TOKEN=

# ── TeamCity (CI/CD) ──────────────────────────────────────────────────────────
# Steps:
#   1. Log in to TeamCity
#   2. Profile icon (top right) → "Access Tokens"  (path: /profile.html?tab=accessTokens)
#   3. "Create access token" → give it a name
#   4. Recommended: create a dedicated read-only service account first, then create
#      the token under that account (not your personal account)
#   5. The token needs no special scope selection — TeamCity tokens inherit the
#      account's permissions, so use an account with View/Read on build configs and
#      VCS roots only
#   6. Copy the token — shown once
#
TC_BASE_URL=https://teamcity.example.com    # your TeamCity instance URL (no trailing slash)
TC_TOKEN=

# ── Octopus Deploy (CI/CD) ────────────────────────────────────────────────────
# Steps:
#   1. Log in to Octopus Deploy
#   2. Profile icon (top right) → "My API Keys"  (or: /app#/users/me/apiKeys)
#   3. "New API Key" → give it a purpose description
#   4. Recommended: use a service account with read-only permissions:
#        Octopus → Configuration → Users → Add service account
#        Assign team: "Octopus Readers" (built-in read-only role)
#   5. Copy the API key — shown once (format: API-XXXXXXXXXX)
#   6. Space ID: Configuration → Spaces → click your space → the URL contains the Space ID
#      (e.g. Spaces-1). If you only have one space it is always Spaces-1.
#
OCTO_URL=https://octopus.example.com        # your Octopus instance URL (no trailing slash)
OCTO_API_KEY=                               # format: API-XXXXXXXXXX
OCTO_SPACE=Spaces-1

# ── LLM gateway (optional — hybrid/agentic mode only, M9+) ───────────────────
# Any OpenAI-compatible endpoint works: LiteLLM, vLLM, Ollama, Azure OpenAI,
# AWS Bedrock via gateway, Anthropic via gateway, or any frontier API.
#
# Examples:
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o
#   Ollama:      LLM_BASE_URL=http://localhost:11434/v1    LLM_MODEL=llama3  LLM_API_KEY=ollama
#   Azure:       LLM_BASE_URL=https://<resource>.openai.azure.com/openai/deployments/<dep>
#                LLM_MODEL=gpt-4o   LLM_API_KEY=<azure-key>
#   LiteLLM:     LLM_BASE_URL=http://localhost:4000/v1    LLM_MODEL=<proxy-model-name>
#
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ── Datadog telemetry (optional, M10+) ────────────────────────────────────────
# Steps:
#   1. Log in to Datadog
#   2. API key: Organization settings → API Keys → "New Key" → name it
#      Needs no specific scopes — API keys are org-wide read access
#   3. App key: Organization settings → Application Keys → "New Key" → name it
#      Scopes needed: apm_service_catalog:read, metrics:read, logs:read
#   4. DD_SITE is your Datadog site: datadoghq.com (US1), datadoghq.eu (EU),
#      us3.datadoghq.com, us5.datadoghq.com, ap1.datadoghq.com
#
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com
